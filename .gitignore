# Gleam / Erlang — generated output in ANY package, at ANY depth.
# One rule, so adding a new probe/package never needs a remembered edit here.
build/
*.beam
*.ez
erl_crash.dump
rebar3.crashdump

# Mix / Phoenix (apps/*)
_build/
deps/
.elixir_ls/

# Node (phoenix assets)
node_modules/

# Editors / OS
*.swp
.DS_Store

# CodeBuddy project-local settings are personal, never committed.
# .codebuddy/CODEBUDDY.md, rules/, skills/, commands/ ARE committed —
# WorkBuddy reads the same directory, so this is the shared entry point.
.codebuddy/settings.local.json
